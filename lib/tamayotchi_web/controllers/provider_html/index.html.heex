<Layouts.navbar_shell>
  <header class="site-header provider-header">
    <div>
      <p class="site-kicker">tamayotchi · portfolio telemetry</p>
      <h1 class="site-title provider-title">{@platform_name}</h1>
    </div>
    <span class="site-count">{format_currency(@stats.latest_value, 2, @currency_code)}</span>
  </header>

  <section class="provider-grid">
    <article class="provider-card">
      <p class="provider-card-label">Contributed Capital</p>
      <p class="provider-card-value">
        {format_currency(@stats.total_contributed, 2, @currency_code)}
      </p>
    </article>

    <article class="provider-card">
      <p class="provider-card-label">Current Tracked Value</p>
      <p class="provider-card-value">{format_currency(@stats.latest_value, 2, @currency_code)}</p>
    </article>

    <article class="provider-card">
      <p class="provider-card-label">Timeline Records</p>
      <p class="provider-card-value">{@stats.records}</p>
    </article>

    <article class="provider-card">
      <p class="provider-card-label">
        <%= if @aggregate? do %>
          {@currency_code} Providers
        <% else %>
          Year-End Marks
        <% end %>
      </p>
      <p class="provider-card-value">
        <%= if @aggregate? do %>
          {@stats.providers}
        <% else %>
          {@stats.year_end_marks}
        <% end %>
      </p>
    </article>
  </section>

  <section class="provider-chart-wrap">
    <div class="provider-chart-head">
      <h2 class="site-year-label">Performance Curve</h2>
      <p class="provider-chart-meta">Contributions and {@compound_label} line</p>
    </div>

    <div class="provider-filters" id="provider-filters">
      <div class="provider-range-group provider-view-group" id="provider-view-options">
        <%= for currency <- ["USD", "COP"] do %>
          <.link
            href={
              filtered_provider_path(
                "/provider/" <> String.downcase(currency),
                @selected_time_range,
                @selected_year,
                @selected_history_order
              )
            }
            class={[
              "provider-filter-pill",
              (@aggregate? and @currency_code == currency) && "provider-filter-pill-active"
            ]}
          >
            All {currency}
          </.link>
        <% end %>
      </div>

      <div class="provider-range-group" id="provider-time-ranges">
        <%= for range <- @time_ranges do %>
          <.link
            href={time_range_path(@platform_path, range, @selected_history_order)}
            class={[
              "provider-filter-pill",
              (@selected_time_range == range and @selected_year == "ALL") &&
                "provider-filter-pill-active"
            ]}
          >
            {range}
          </.link>
        <% end %>
      </div>

      <div class="provider-range-group" id="provider-growth-option">
        <a
          href="#provider-yearly-growth"
          class="provider-filter-pill provider-filter-pill-secondary"
        >
          Yearly Growth
        </a>
      </div>

      <.form
        :let={form}
        for={to_form(%{"year" => @selected_year, "time_range" => @selected_time_range})}
        method="get"
        action={@platform_path}
        id="provider-year-filter-form"
        class="provider-year-filter-form"
      >
        <.input
          type="select"
          id="provider-year-filter"
          field={form[:year]}
          options={@year_options}
        />
        <input type="hidden" name={form[:time_range].name} value={form[:time_range].value} />
        <input type="hidden" name="history_order" value={@selected_history_order} />
        <button type="submit" id="provider-year-apply" class="provider-filter-apply">
          Apply
        </button>
      </.form>
    </div>

    <% chart_has_data = @chart.points != [] or @chart.compound_points != [] %>

    <%= if not chart_has_data do %>
      <p class="provider-empty">No {@platform_name} data found yet.</p>
    <% else %>
      <div class="provider-chart-shell">
        <svg
          viewBox={"0 0 #{@chart.width} #{@chart.height}"}
          class="provider-chart"
          role="img"
          aria-label={"#{@platform_name} portfolio growth chart"}
        >
          <defs>
            <linearGradient id="providerAreaGlow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(116,255,203,0.45)" />
              <stop offset="100%" stop-color="rgba(116,255,203,0.02)" />
            </linearGradient>
          </defs>

          <%= for tick <- @chart.y_ticks do %>
            <line x1="54" y1={tick.y} x2="936" y2={tick.y} class="provider-grid-line" />
            <text x="8" y={tick.y + 4} class="provider-axis-label">
              {format_currency(tick.value, 0, @currency_code)}
            </text>
          <% end %>

          <path d={@chart.area_path} class="provider-area" />
          <path d={@chart.line_path} class="provider-line" />
          <path d={@chart.compound_line_path} class="provider-compound-line" />

          <%= for point <- @chart.points do %>
            <%= if not Map.get(point, :synthetic_start?, false) do %>
              <circle
                cx={point.x}
                cy={point.y}
                r="2.8"
                class="provider-point"
              />
            <% end %>
          <% end %>

          <%= for point <- @chart.compound_points do %>
            <circle
              cx={point.x}
              cy={point.y}
              r="4.2"
              class="provider-compound-point"
            />
          <% end %>

          <%= for label <- @chart.x_labels do %>
            <text x={label.x} y="350" class="provider-axis-label" text-anchor="middle">
              {label.label}
            </text>
          <% end %>
        </svg>
      </div>

      <div class="provider-legend" id="provider-legend">
        <span class="provider-legend-item">
          <span class="provider-legend-dot provider-legend-dot-contribution"></span> Contributions
        </span>
        <%= if @show_compound? do %>
          <span class="provider-legend-item">
            <span class="provider-legend-dot provider-legend-dot-compound"></span> {@compound_label}
          </span>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="provider-growth-wrap" id="provider-yearly-growth">
    <div class="provider-chart-head">
      <h2 class="site-year-label">Year-End Growth</h2>
      <p class="provider-chart-meta">
        Generated gain as share of end balance plus yearly gain excluding deposits
      </p>
    </div>

    <%= if @annual_growth_rows == [] do %>
      <p class="provider-empty">
        No year-end growth records yet. Add Dec 31 entries marked as year-end values to track
        yearly percentage growth.
      </p>
    <% else %>
      <div class="provider-growth-table-shell">
        <table class="provider-growth-table" id="provider-yearly-growth-table">
          <thead>
            <tr>
              <th>Year</th>
              <th class="is-right">End Value</th>
              <th class="is-right">Contributed</th>
              <th class="is-right">Generated</th>
              <th class="is-right">Gain Share %</th>
              <th class="is-right">Year Generated</th>
              <th class="is-right">Year %</th>
            </tr>
          </thead>
          <tbody>
            <%= for row <- @annual_growth_rows do %>
              <tr>
                <td>
                  <span class="provider-growth-year">{row.year}</span>
                  <%= if row.previous_year do %>
                    <span class="provider-growth-compare">vs {row.previous_year}</span>
                  <% else %>
                    <span class="provider-growth-compare">vs contributed total</span>
                  <% end %>
                </td>
                <td class="is-right">
                  {format_currency(row.end_value, 2, @currency_code)}
                </td>
                <td class="is-right">
                  {format_currency(row.contributed_to_date, 2, @currency_code)}
                </td>
                <td class={["is-right", growth_tone_class(row.increase_amount)]}>
                  {format_signed_currency(row.increase_amount, 2, @currency_code)}
                </td>
                <td class={["is-right", growth_tone_class(row.increase_percentage)]}>
                  {format_growth_percentage(row.increase_percentage)}
                </td>
                <td class={["is-right", growth_tone_class(row.year_increase_amount)]}>
                  {format_signed_currency(row.year_increase_amount, 2, @currency_code)}
                </td>
                <td class={["is-right", growth_tone_class(row.year_increase_percentage)]}>
                  {format_growth_percentage(row.year_increase_percentage)}
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="provider-growth-note">
        Gain Share % = Generated / End Value. Year % excludes new deposits from the yearly
        result.
      </p>
    <% end %>
  </section>

  <%= if @provider_breakdown != [] do %>
    <section class="provider-breakdown-wrap" id="provider-breakdown">
      <div class="provider-chart-head">
        <h2 class="site-year-label">{@currency_code} Provider Breakdown</h2>
        <p class="provider-chart-meta">
          Invested by platform · {active_filter_label(@selected_time_range, @selected_year)}
        </p>
      </div>

      <div
        class="provider-breakdown-bars"
        role="img"
        aria-label={@currency_code <> " invested by provider"}
      >
        <%= for breakdown <- @provider_breakdown do %>
          <div class="provider-breakdown-row">
            <div class="provider-breakdown-label">{breakdown.provider}</div>
            <div class="provider-breakdown-track">
              <div
                class="provider-breakdown-fill"
                style={"width: #{breakdown.percentage}%"}
              >
              </div>
            </div>
            <div class="provider-breakdown-value">
              {format_currency(breakdown.total, 2, @currency_code)}
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="provider-history-wrap" id="provider-history">
    <div class="provider-chart-head">
      <h2 class="site-year-label">Investment History</h2>
      <p class="provider-chart-meta">
        Filtered timeline details · {active_filter_label(@selected_time_range, @selected_year)}
      </p>
    </div>

    <div class="provider-history-toolbar" id="provider-history-toolbar">
      <span class="provider-history-filter-chip">
        {active_filter_label(@selected_time_range, @selected_year)}
      </span>

      <.form
        :let={form}
        for={to_form(%{"history_order" => @selected_history_order})}
        method="get"
        action={@platform_path}
        id="provider-history-order-form"
        class="provider-history-order-form"
      >
        <input type="hidden" name="time_range" value={@selected_time_range} />
        <input type="hidden" name="year" value={@selected_year} />
        <.input
          type="select"
          id="provider-history-order"
          field={form[:history_order]}
          options={@history_order_options}
        />
        <button type="submit" id="provider-history-order-apply" class="provider-filter-apply">
          Sort
        </button>
      </.form>
    </div>

    <%= if @history_rows == [] do %>
      <p class="provider-empty">No contribution records for this filter.</p>
    <% else %>
      <div class="provider-history-table-shell">
        <table class="provider-history-table" id="provider-history-table">
          <thead>
            <tr>
              <th>Date</th>
              <%= if @show_provider_column? do %>
                <th>Provider</th>
              <% end %>
              <th class="is-right">Amount</th>
              <th class="is-right">Cumulative</th>
            </tr>
          </thead>
          <tbody>
            <%= for row <- @history_rows do %>
              <tr>
                <td>{format_history_date(row.date)}</td>
                <%= if @show_provider_column? do %>
                  <td>{row.provider}</td>
                <% end %>
                <td class="is-right">
                  {format_currency(row.amount, 2, @currency_code)}
                </td>
                <td class="is-right">
                  {format_currency(row.portfolio_value, 2, @currency_code)}
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <td>Total</td>
              <%= if @show_provider_column? do %>
                <td>All {@currency_code}</td>
              <% end %>
              <td class="is-right">
                {format_currency(@stats.total_contributed, 2, @currency_code)}
              </td>
              <td class="is-right">
                {format_currency(@stats.total_contributed, 2, @currency_code)}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  </section>
</Layouts.navbar_shell>
